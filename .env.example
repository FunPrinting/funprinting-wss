# Secret used to verify partner socket JWTs (must match the web app's NEXTAUTH_SECRET).
NEXTAUTH_SECRET=

# Secret for partner app access tokens (device sign-in); same value as the web app's PARTNER_JWT_SECRET
PARTNER_JWT_SECRET=
# Shared secret for signing POST /api/dispatch-print-job and /api/cancel-print-job.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WSS_DISPATCH_SECRET=

# Comma-separated browser origins allowed for CORS / Socket.IO.
# Requests without an Origin header (Electron, mobile, server-to-server) are always allowed.
ALLOWED_ORIGINS=https://funprinting.store,https://www.funprinting.store

# Optional: web app base URL; errors and warnings are sent to its /api/errors (signed
# with WSS_DISPATCH_SECRET) and appear in /admin/errors. Unset = log only.
WEB_API_URL=https://www.funprinting.store
PORT=3001
